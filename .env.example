# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ELEVENLABS_API_KEY=your_elevenlabs_api_key
OPENAI_API_KEY=your_openai_api_key

# Optional
ADMIN_USER_IDS=123456789  # Comma-separated Telegram user IDs
DATABASE_PATH=./stats.db  # Railway Volume: /data/stats.db
MAX_AUDIO_DURATION=3600   # Max audio duration in seconds (default: 3600 = 1 hour)
TRANSCRIPTION_TTL=600     # Transcription expiry in seconds (default: 600 = 10 min)
HEARTBEAT_URL=            # Heartbeat monitor ping URL; empty disables it
HEARTBEAT_INTERVAL_SECONDS=60  # How often the bot pings the monitor

# Voiceover: text read out in the bot author's voice. Empty TTS_VOICE_ID = off.
TTS_VOICE_ID=WTn2eCRCpoFAC50VD351
TTS_MODEL=eleven_v4
TTS_USD_PER_1K_CHARS=0.08       # ElevenLabs price, for cost estimates
TTS_USER_QUOTA_MINUTES=10       # per non-admin user ...
TTS_QUOTA_DAYS=30               # ... per this many days
TTS_CONFIRM_USD=1.0             # admins confirm voiceovers above this cost
TTS_NOTIFY_ADMINS=true          # DM admins when someone else uses the voice
LOG_LEVEL=INFO

# Admin dashboard at <PUBLIC_URL>/admin (send /admin to the bot). On Railway,
# generating a domain for the service sets RAILWAY_PUBLIC_DOMAIN, which is used
# when PUBLIC_URL is empty.
PUBLIC_URL=

# Cost estimates for the dashboard and the donation nudge
ELEVENLABS_USD_PER_HOUR=0.40  # your plan's price / included hours of Scribe
STAR_USD=0.013                # what one Telegram Star pays out
DONATION_NUDGE_USD=1.0        # nudge a user after this much spend on them; 0 = off
DONATION_NUDGE_INTERVAL_DAYS=14

# Files over 20 MB: run a local Telegram Bot API server inside the container
# (credentials from https://my.telegram.org). See README.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_API_DIR=/data/telegram-bot-api
FILE_DOWNLOAD_TIMEOUT=60  # Raise to 600 with the local server: big files take a while
